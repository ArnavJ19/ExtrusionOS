# The runner skips unless both opt-in values match exactly.
E2E_STAGING_ENABLED=true
E2E_STAGING_MUTATION_CONFIRM=seed-isolated-staging-fixtures

# Must be a remote HTTPS staging deployment and its separate Supabase project.
E2E_STAGING_BASE_URL=https://your-staging-app.example.com
E2E_STAGING_SUPABASE_URL=https://your-staging-project-ref.supabase.co
E2E_STAGING_PROJECT_REF=your-staging-project-ref
E2E_STAGING_SUPABASE_SERVICE_ROLE_KEY=staging-only-service-role-key

# Existing active users in the same staging company. Use owner/admin accounts.
E2E_STAGING_PRIMARY_EMAIL=staging-owner-1@example.com
E2E_STAGING_PRIMARY_PASSWORD=replace-me
E2E_STAGING_SECONDARY_EMAIL=staging-owner-2@example.com
E2E_STAGING_SECONDARY_PASSWORD=replace-me

# Optional: returned/damaged dispatch with a non-cancelled invoice.
E2E_STAGING_CREDIT_DISPATCH_ID=
