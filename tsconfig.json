{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-acceptance/types/**/*.ts",
    ".next-acceptance/dev/types/**/*.ts",
    ".next-acceptance-build/types/**/*.ts",
    ".next-acceptance-build/dev/types/**/*.ts",
    ".next-upgrade-verify/types/**/*.ts",
    ".next-upgrade-verify/dev/types/**/*.ts",
    ".next-eos-batch5/types/**/*.ts",
    ".next-eos-batch5/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".worktrees",
    ".next",
    ".next-*",
    "test-costing.ts"
  ]
}
